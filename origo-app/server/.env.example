# PostgreSQL (local natif ou Docker)
DATABASE_URL="postgresql://origo:origo@localhost:5432/origo?schema=public"

# Obligatoire en production : ≥ 32 caractères, unique, jamais un placeholder
JWT_SECRET="change-moi-en-production-origo-2026"
# Durée session (prod défaut 16h si NODE_ENV=production)
JWT_EXPIRES_IN="7d"

NODE_ENV="development"
PORT=3001
HOST=0.0.0.0
LOG_LEVEL="debug"

# Nombre de reverse proxies devant l'API (1 avec Caddy en production).
# Sans ceci en prod, toutes les requêtes semblent venir du proxy et le
# rate-limit login devient global. Inutile en dev.
# TRUST_PROXY=1

# Validité des URLs signées de /uploads (secondes, défaut 6h). Les photos ne sont
# servies qu'avec une signature dérivée de JWT_SECRET : changer JWT_SECRET invalide
# les URLs déjà distribuées (sans effet sur les fichiers).
# UPLOADS_URL_TTL_S=21600

# CORS : origines exactes du front (jamais * en prod)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# --- Odoo (optionnel) ---
# Tant que ces 4 variables ne sont pas toutes remplies, l'intégration est
# désactivée et ORIGO fonctionne seul. Pour le bac à sable local :
#   docker compose -f ../odoo-lab/docker-compose.yml up -d
# ODOO_URL="http://127.0.0.1:8069"
# ODOO_DB="origo_lab"
# ODOO_USER="admin"
# En production : clé API d'un compte robot, jamais un mot de passe (voir ODOO.md § 5)
# ODOO_API_KEY="admin"
# ODOO_TIMEOUT_MS=15000
# ODOO_TENTATIVES=3
# ODOO_SONDE_INTERVALLE_MS=900000
#
# Poussée ORIGO → Odoo : Tableau de bord → Envoyer le catalogue.
# Les commandes restent dans ORIGO jusqu'à la bascule (voir ODOO.md § 8).

# Société (Belgique)
COMPANY_NAME="ORIGO"
COMPANY_ADDRESS="Avenue des Anciens Combattants 23, 1140 Evere"
COMPANY_EMAIL="mehdi@origobrussels.be"
COMPANY_PHONE="+32 468 08 96 03"
COMPANY_VAT=""
TVA_RATE="0.21"
DELAI_MODIFICATION_MS="3600000"

# Dossier des marqueurs origo.last_ok / origo.last_fail (job pg-backup-loop).
# En prod Docker : /backups (volume monté en lecture). Vide en local.
# BACKUP_STATUS_DIR=

# URL publique du front (retour Stripe). Défaut : première origine CORS.
# PUBLIC_URL=http://localhost:5173

# Paiement carte + prélèvement SEPA (mandat IBAN). Sans clé, SEPA n'encaisse pas.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SMS statuts commande (optionnel). Sans les 3 variables, aucun SMS n'est envoyé.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
