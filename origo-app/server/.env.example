# PostgreSQL (local natif ou Docker)
DATABASE_URL="postgresql://origo:origo@localhost:5432/origo?schema=public"

# Obligatoire en production : ≥ 32 caractères, unique, jamais un placeholder
JWT_SECRET="change-moi-en-production-origo-2026"
# Durée session (prod défaut 12h si NODE_ENV=production)
JWT_EXPIRES_IN="7d"

NODE_ENV="development"
PORT=3001
HOST=0.0.0.0

# CORS : origines exactes du front (jamais * en prod)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Société (Belgique)
COMPANY_NAME="ORIGO"
COMPANY_ADDRESS="À compléter — Belgique"
COMPANY_EMAIL="pro@origo.be"
COMPANY_PHONE="+32 2 000 00 00"
COMPANY_VAT="BE0000000000"
TVA_RATE="0.21"
DELAI_MODIFICATION_MS="3600000"
