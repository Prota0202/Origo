// ORIGO — schéma métier B2B (Belgique) — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleStaff {
  DIRECTION
  PREPARATION
  LIVREUR
}

enum StatutCommande {
  CONFIRMEE
  PREPAREE
  EN_LIVRAISON
  LIVREE
  LIVREE_PARTIELLEMENT
  ANNULEE
}

enum TypeMouvementStock {
  ENTREE
  SORTIE_COMMANDE
  RETOUR
  AJUSTEMENT
}

/// Compte interne ORIGO (direction, préparation, livreur)
model Staff {
  id             String    @id @default(cuid())
  code           String    @unique
  motDePasseHash String
  nom            String
  role           RoleStaff
  actif          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commandesPreparees OrderItem[] @relation("PreparePar")
  livraisons         Order[]     @relation("LivrePar")
}

/// Restaurant / client B2B
model Client {
  id             String   @id @default(cuid())
  code           String   @unique
  motDePasseHash String
  nom            String
  ville          String?
  email          String?
  telephone      String?
  adresse        String?
  numeroTva      String?
  minCartons     Int      @default(5)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catalogue CatalogEntry[]
  favoris   ClientFavori[]
  notes     ClientNote[]
  paliers   PrixPalier[]
  commandes Order[]
  demandes  DemandeProduit[]
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  nom             String
  description     String   @default("")
  categorie       String
  unitesParCarton Int
  prixCarton      Decimal  @db.Decimal(10, 2)
  stock           Int      @default(0)
  seuilAlerte     Int      @default(10)
  photoUrl        String?
  /// Remise catalogue : seuil cartons + % (null = pas de remise)
  remiseSeuil     Int?
  remisePourcent  Decimal? @db.Decimal(5, 2)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogue       CatalogEntry[]
  favoris         ClientFavori[]
  notes           ClientNote[]
  paliers         PrixPalier[]
  orderItems      OrderItem[]
  stockMouvements StockMouvement[]
  demandes        DemandeProduit[]

  @@index([categorie])
  @@index([actif])
}

/// Produits visibles + prix négocié par client
model CatalogEntry {
  id          String   @id @default(cuid())
  clientId    String
  productId   String
  prixNegocie Decimal? @db.Decimal(10, 2)
  visible     Boolean  @default(true)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId])
}

model ClientFavori {
  clientId  String
  productId String

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientId, productId])
}

model ClientNote {
  clientId  String
  productId String
  texte     String

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientId, productId])
}

/// Paliers de prix dégressifs par client / produit
model PrixPalier {
  id        String  @id @default(cuid())
  clientId  String
  productId String
  seuil     Int
  prix      Decimal @db.Decimal(10, 2)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId, seuil])
  @@index([clientId, productId])
}

model Order {
  id                  String         @id @default(cuid())
  numero              String         @unique
  clientId            String
  statut              StatutCommande @default(CONFIRMEE)
  cartonsTotal        Int
  totalHT             Decimal        @db.Decimal(12, 2)
  payee               Boolean        @default(false)
  dateLivraisonPrevue DateTime?
  photoLivraisonUrl   String?
  noteLivraison       String?
  livreParId          String?
  motifAnnulation     String?
  annuleeLe           DateTime?
  modifieeLe          DateTime?
  livreeLe            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  client          Client           @relation(fields: [clientId], references: [id])
  livrePar        Staff?           @relation("LivrePar", fields: [livreParId], references: [id])
  items           OrderItem[]
  stockMouvements StockMouvement[]
  retours         RetourCommande[]

  @@index([clientId])
  @@index([statut])
  @@index([createdAt])
  @@index([updatedAt])
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  productId       String
  nomSnapshot     String
  quantiteCartons Int
  prixUnitaire    Decimal   @db.Decimal(10, 2)
  /// null = pas encore traité à la livraison ; true/false = livré ou non
  livree          Boolean?
  coche           Boolean   @default(false)
  cocheLe         DateTime?
  prepareParId    String?

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  preparePar Staff?  @relation("PreparePar", fields: [prepareParId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StockMouvement {
  id         String             @id @default(cuid())
  productId  String
  type       TypeMouvementStock
  quantite   Int
  stockApres Int
  orderId    String?
  note       String?
  createdAt  DateTime           @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model DemandeProduit {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([traite])
}

model RetourCommande {
  id        String   @id @default(cuid())
  orderId   String
  motif     String
  createdAt DateTime @default(now())

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lignes RetourLigne[]
}

model RetourLigne {
  id           String  @id @default(cuid())
  retourId     String
  productId    String
  quantite     Int
  remisEnStock Boolean @default(true)

  retour RetourCommande @relation(fields: [retourId], references: [id], onDelete: Cascade)
}

/// Compteur atomique pour numéros de commande CMD-0001…
model Sequence {
  nom    String @id
  valeur Int    @default(0)
}
