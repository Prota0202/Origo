// ORIGO — schéma métier B2B (Belgique) — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleStaff {
  DIRECTION
  PREPARATION
  LIVREUR
}

enum StatutCommande {
  CONFIRMEE
  PREPAREE
  EN_LIVRAISON
  LIVREE
  LIVREE_PARTIELLEMENT
  ANNULEE
}

enum TypeMouvementStock {
  ENTREE
  SORTIE_COMMANDE
  RETOUR
  AJUSTEMENT
}

/// Compte interne ORIGO (direction, préparation, livreur)
model Staff {
  id             String    @id @default(cuid())
  code           String    @unique
  motDePasseHash String
  nom            String
  role           RoleStaff
  actif          Boolean   @default(true)
  /// true = la session ne peut que changer le mot de passe (seed / fuite).
  mdpAChanger    Boolean   @default(false)
  /// Incrémenté au changement de mot de passe / désactivation : les cookies déjà émis meurent.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commandesPreparees OrderItem[] @relation("PreparePar")
  livraisons         Order[]     @relation("LivrePar")
}

/// Fiche société affichée sur les bons / l'écran service client.
/// Une seule ligne (`id = origo`). Les env COMPANY_* servent de repli
/// tant que la direction n'a rien saisi ici.
model Societe {
  id        String   @id @default("origo")
  nom       String
  adresse   String   @default("")
  email     String   @default("")
  telephone String   @default("")
  /// Vide jusqu'au n° TVA (début septembre). Ne jamais afficher un placeholder.
  numeroTva String   @default("")
  horaires  String   @default("Lun – Ven · 8h00 – 18h00")
  /// Conditions affichées et signées au panier. Vide = texte par défaut serveur.
  conditionsGenerales String @default("")
  updatedAt DateTime @updatedAt
}

/// Restaurant / client B2B
model Client {
  id             String   @id @default(cuid())
  code           String   @unique
  motDePasseHash String
  nom            String
  ville          String?
  email          String?
  telephone      String?
  adresse        String?
  numeroTva      String?
  minCartons     Int      @default(5)
  /// `sepa` (domiciliation), `stripe` (carte à la commande), `virement`.
  modePaiement   String   @default("sepa")
  /// Calendrier de prélèvement SEPA (JSON). Null = 15 et dernier jour du mois.
  sepaCalendrier Json?
  actif          Boolean  @default(true)
  mdpAChanger    Boolean  @default(false)
  sessionVersion Int      @default(0)
  stripeCustomerId           String?   @unique
  stripeSepaPaymentMethodId  String?
  sepaIbanLast4              String?
  sepaMandatId               String?
  sepaMandatAccepteLe        DateTime?
  /// Id du `res.partner` chez Odoo. Null tant que jamais synchronisé.
  odooId         Int?     @unique
  /// Id de la `product.pricelist` rattachée à ce partenaire.
  odooTarifId    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catalogue CatalogEntry[]
  favoris   ClientFavori[]
  notes     ClientNote[]
  paliers   PrixPalier[]
  commandes     Order[]
  demandes      DemandeProduit[]
  prelevements  PrelevementSepa[]
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  nom             String
  description     String   @default("")
  categorie       String
  unitesParCarton Int
  prixCarton      Decimal  @db.Decimal(10, 2)
  stock           Int      @default(0)
  seuilAlerte     Int      @default(10)
  photoUrl        String?
  /// Remise catalogue : seuil cartons + % (null = pas de remise)
  remiseSeuil     Int?
  remisePourcent  Decimal? @db.Decimal(5, 2)
  actif           Boolean  @default(true)
  /// Id du `product.template` chez Odoo. Null tant que jamais synchronisé.
  odooId          Int?     @unique
  /// Id du `product.product` (variante unique). Nécessaire pour poser un stock.
  odooVarianteId  Int?     @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogue       CatalogEntry[]
  favoris         ClientFavori[]
  notes           ClientNote[]
  paliers         PrixPalier[]
  orderItems      OrderItem[]
  stockMouvements StockMouvement[]
  demandes        DemandeProduit[]

  @@index([categorie])
  @@index([actif])
}

/// Produits visibles + prix négocié par client
model CatalogEntry {
  id          String   @id @default(cuid())
  clientId    String
  productId   String
  prixNegocie Decimal? @db.Decimal(10, 2)
  visible     Boolean  @default(true)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId])
}

model ClientFavori {
  clientId  String
  productId String

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientId, productId])
}

model ClientNote {
  clientId  String
  productId String
  texte     String

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientId, productId])
}

/// Paliers de prix dégressifs par client / produit
model PrixPalier {
  id        String  @id @default(cuid())
  clientId  String
  productId String
  seuil     Int
  prix      Decimal @db.Decimal(10, 2)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId, seuil])
  @@index([clientId, productId])
}

model Order {
  id                  String         @id @default(cuid())
  numero              String         @unique
  clientId            String
  statut              StatutCommande @default(CONFIRMEE)
  cartonsTotal        Int
  totalHT             Decimal        @db.Decimal(12, 2)
  payee               Boolean        @default(false)
  dateLivraisonPrevue DateTime?
  photoLivraisonUrl   String?
  noteLivraison       String?
  livreParId          String?
  motifAnnulation     String?
  annuleeLe           DateTime?
  modifieeLe          DateTime?
  livreeLe            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Frais de livraison HT figés à la commande (0 si franco ≥ 150 € HT articles).
  fraisLivraisonHT    Decimal        @default(0) @db.Decimal(10, 2)
  cgvAccepteesLe      DateTime?
  signatureNom        String?
  /// Trait manuscrit capturé dans l’app (fichier /uploads, pas du base64).
  signatureImageUrl   String?
  /// Nom du `sale.order` Odoo (S00012), pour que le PDF app = le PDF Odoo.
  odooNom             String?
  odooFactureId       Int?           @unique
  stripeSessionId     String?
  /// Id du `sale.order` Odoo. Null tant que la poussée n'a pas abouti.
  odooId              Int?           @unique
  /// `attente` | `ok` | `erreur`. Null = commande d'avant la liaison ventes.
  odooSyncStatut      String?
  odooSyncErreur      String?
  odooSyncLe          DateTime?
  prelevementSepaId   String?

  client          Client           @relation(fields: [clientId], references: [id])
  livrePar        Staff?           @relation("LivrePar", fields: [livreParId], references: [id])
  items           OrderItem[]
  stockMouvements StockMouvement[]
  retours         RetourCommande[]
  prelevementSepa PrelevementSepa? @relation(fields: [prelevementSepaId], references: [id])

  @@index([clientId])
  @@index([statut])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([odooSyncStatut])
  @@index([prelevementSepaId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  nomSnapshot String
  /// Quantité facturée : réduite à la livraison partielle ou après un retour
  quantiteCartons Int
  /// Quantité commandée à l'origine, jamais modifiée après création.
  /// Sans elle, impossible de rouvrir une commande livrée sans corrompre stock et total.
  quantiteCommandee Int?
  prixUnitaire      Decimal @db.Decimal(10, 2)
  /// null = pas encore traité à la livraison ; true/false = livré ou non
  livree          Boolean?
  coche           Boolean   @default(false)
  cocheLe         DateTime?
  prepareParId    String?

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  preparePar Staff?  @relation("PreparePar", fields: [prepareParId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StockMouvement {
  id         String             @id @default(cuid())
  productId  String
  type       TypeMouvementStock
  quantite   Int
  stockApres Int
  orderId    String?
  note       String?
  createdAt  DateTime           @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model DemandeProduit {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([traite])
}

model RetourCommande {
  id        String   @id @default(cuid())
  orderId   String
  motif     String
  createdAt DateTime @default(now())

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lignes RetourLigne[]
}

model RetourLigne {
  id           String  @id @default(cuid())
  retourId     String
  productId    String
  quantite     Int
  remisEnStock Boolean @default(true)

  retour RetourCommande @relation(fields: [retourId], references: [id], onDelete: Cascade)
}

/// Prélèvement SEPA groupé (15 ou dernier jour du mois, fuseau Bruxelles).
model PrelevementSepa {
  id                    String   @id @default(cuid())
  clientId              String
  periodeCle            String
  montantCents          Int
  /// attente | envoye | paye | echec
  statut                String
  stripePaymentIntentId String?  @unique
  erreur                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commandes  Order[]

  @@unique([clientId, periodeCle])
  @@index([statut])
}

/// Compteur atomique pour numéros de commande CMD-0001…
model Sequence {
  nom    String @id
  valeur Int    @default(0)
}
