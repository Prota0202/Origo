# ORIGO — configuration production. Copier en .env.prod (jamais commité) et remplir.
# Secrets : openssl rand -hex 24   (évite @ : / qui cassent l'URL Postgres)

# --- Domaine ---
# Domaine complet servi par Caddy → certificat HTTPS automatique.
# Pour un test local sans certificat : SITE_ADDRESS=:80
SITE_ADDRESS=commande.mondomaine.be
# Email pour Let's Encrypt (avis d'expiration de certificat) — obligatoire hors test :80
ACME_EMAIL=toi@mondomaine.be

# Front et API sont sur la même origine : reprendre exactement le domaine ci-dessus
CORS_ORIGIN=https://commande.mondomaine.be

# --- Base de données ---
POSTGRES_USER=origo
POSTGRES_DB=origo
# Obligatoire, ≥ 16 caractères, sans @ : / ? # : openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Sécurité API ---
# Obligatoire, ≥ 32 caractères, jamais un placeholder : openssl rand -hex 32
JWT_SECRET=
# Session courte = moins de dégâts si un token est volé
JWT_EXPIRES_IN=16h
LOG_LEVEL=info
# Validité des URLs signées des photos (secondes). Les photos de livraison sont
# des données personnelles : plus la durée est courte, moins une URL copiée par
# erreur reste exploitable. Trop court = images cassées dans un onglet resté ouvert.
UPLOADS_URL_TTL_S=21600

# --- Premier compte direction ---
# Mettre BOOTSTRAP_ADMIN=1 + ADMIN_PASSWORD (≥ 12, pas un mot de passe de démo)
# pour le 1er déploiement, puis REPASSER À 0.
BOOTSTRAP_ADMIN=0
ADMIN_CODE=ORIGO
ADMIN_PASSWORD=

# --- Odoo ---
# Décision actuelle : Odoo Online (origo.odoo.com), PAS Community sur le VPS.
# WITH_ODOO=1 installerait un 2ᵉ Odoo (deux comptabilités) — ne pas le faire.
WITH_ODOO=0
ODOO_URL=https://origo.odoo.com
ODOO_DB=origo
ODOO_USER=ton-email
ODOO_API_KEY=

# Odoo Community sur le VPS (plus tard seulement, et après résiliation Online) :
# WITH_ODOO=1
# ODOO_SITE_ADDRESS=odoo.mondomaine.be
# ODOO_PG_USER=odoo
# ODOO_PG_PASSWORD=
# ODOO_URL=http://odoo:8069
# ODOO_USER=admin
# ODOO_ADMIN_PASSWORD=

# --- Backups ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Chemin HÔTE d'un disque / Object Storage monté. Si vide, dumps + photos restent
# sur le VPS (perdus avec lui). Filet actuel : snapshots Contabo + ./scripts/pull-backups.sh
# vers le Mac (LaunchAgent : ./scripts/install-pull-backups-mac.sh, toutes les 20 min).
# Un vrai disque distant (Storage Box) si le Mac n’est pas allumé 24/7 — avant Hetzner.
# BACKUP_OFFSITE_HOST_DIR=/mnt/offsite/origo

# --- Société (factures / PDF) ---
COMPANY_NAME=ORIGO
COMPANY_ADDRESS="Avenue des Anciens Combattants 23, 1140 Evere"
COMPANY_EMAIL=pro@origo.be
COMPANY_PHONE="+32 468 08 96 03"
COMPANY_VAT=
TVA_RATE=0.21
DELAI_MODIFICATION_MS=3600000

# NE PAS activer en production : ce seed efface toutes les données.
# SEED_ON_START=0

# URL publique du front (retour Stripe Checkout). En prod : https://origo-app.be
# PUBLIC_URL=https://origo-app.be

# Paiement carte + prélèvement SEPA (mandat IBAN, 15 et fin de mois).
# Sans clé, aucun encaissement. Webhook : checkout.session.completed,
# setup_intent.succeeded, payment_intent.succeeded, payment_intent.payment_failed.
# STRIPE_SECRET_KEY=
# Endpoint : https://origo-app.be/api/v1/stripe/webhook
# STRIPE_WEBHOOK_SECRET=

# SMS statuts (optionnel). Sans les 3, les commandes passent quand même.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
