# Front React buildé, servi par Caddy (HTTPS automatique + reverse proxy vers l'API).
# Le front appelle l'API en chemins relatifs (/api, /uploads) : même origine,
# donc rien à recompiler si le domaine change.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80 443
